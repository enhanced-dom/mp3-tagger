{
  "name": "@enhanced-dom/mp3-tagger",
  "version": "0.3.0",
  "description": "Tagging utility for mp3 files",
  "repository": "https://github.com/enhanced-dom/mp3-tagger.git",
  "main": "config.js",
  "scripts": {
    "configure-claude": "@enhanced-dom-claude --configs react code agent rtk devcontainer caveman-lite",
    "configure-lint": "@enhanced-dom-fallow --gitignore && @enhanced-dom-npmrc --gitignore && @enhanced-dom-nvmrc --gitignore && @enhanced-dom-husky --gitignore",
    "configure-build": "@enhanced-dom-bootstrap-tsconfig",
    "prepare": "npm run configure-lint && npm run configure-claude && npm run configure-build",
    "package": "ncc build ./dist/index.mjs -o ./dist",
    "prebuild": "rimraf dist/*",
    "build": "tsc -p ./tsconfig.json",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "postbuild": "copyfiles script.sh dist && node --import tsx templatize-script.ts",
    "lint": "eslint src/** --fix --config eslint.config.mjs"
  },
  "type": "module",
  "keywords": [],
  "author": "CD9B4A105290E17E0948E021DF4105107C88693C59C0B891CCC08366C51AEA990902A6A156AC87D88A2FC41422A5E1C3C4071F251F19441C4516000EC25F87DF",
  "license": "MIT",
  "dependencies": {
    "node-id3": "^0.2.9",
    "fs-extra": "^11.4.1"
  },
  "devDependencies": {
    "@enhanced-dom/build": "^0.3.2",
    "@enhanced-dom/claude": "^0.3.1",
    "@enhanced-dom/lint": "^0.4.2",
    "@types/node": "^22.20.5",
    "@types/fs-extra": "^11.0.4",
    "@types/yargs": "^17.0.35",
    "@vercel/ncc": "^0.45.0",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=22.23.2",
    "npm": ">=12"
  }
}
