    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@enhanced-dom/build": "^0.2.0",
    "@enhanced-dom/lint": "^0.2.1",
    "@types/node": "^20.19.27",
    "@types/fs-extra": "^11.0.4",
    "@types/yargs": "^17.0.33",
